{
  "name": {
    "en": "Virtual thermostat",
    "fr": "Thermostat virtuel",
    "nl": "Virtuele thermostaat",
    "de": "Virtueller Thermostat"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "thermostat_override"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 4,
      "max": 35,
      "step": 0.5
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
